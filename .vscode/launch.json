{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vault.Cli",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Vault.Cli/bin/Debug/net11.0/Vault.Cli.dll",
      "args": [
        "metadata",
        "-c",
        "gba"
      ],
      "cwd": "${workspaceFolder}/Vault.Cli",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Vault.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Vault.Api/bin/Debug/net11.0/Vault.Api.dll",
      "cwd": "${workspaceFolder}/Vault.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}